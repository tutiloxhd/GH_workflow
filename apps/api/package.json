{
  "name": "workflow-api",
  "version": "0.1.0",
  "private": true,
  "description": "API del workflow de remates judiciales",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/entrypoints/api.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/entrypoints/api.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "sync": "tsx --env-file=.env src/entrypoints/sync.ts",
    "sync:start": "node --env-file=.env dist/entrypoints/sync.js",
    "users:import-admin-new-agents": "tsx --env-file=.env src/entrypoints/import-admin-new-agents.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/entrypoints/migrate.ts",
    "users:create-admin": "tsx --env-file=.env src/entrypoints/create-admin.ts",
    "notifications:worker": "tsx --env-file=.env src/entrypoints/notifications-worker.ts",
    "notifications:worker:start": "node --env-file=.env dist/entrypoints/notifications-worker.js",
    "notifications:scheduler": "tsx --env-file=.env src/entrypoints/notifications-scheduler.ts",
    "notifications:scheduler:start": "node --env-file=.env dist/entrypoints/notifications-scheduler.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
