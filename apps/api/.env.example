# Copiar a .env y completar con valores locales. El archivo .env nunca se versiona.
NODE_ENV=development
PORT=3000

# Base propia del workflow (lectura y escritura)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=workflow
DB_USER=workflow_app
DB_PASSWORD=cambiar-por-una-clave-local

# Base usada solo por las pruebas automatizadas; debe ser distinta de DB_NAME
DB_TEST_NAME=workflow_test

# Base del sistema externo admin_new (solo lectura desde la aplicación)
ADMIN_NEW_DB_NAME=admin_new
# Opcionales: si faltan se usan los valores de DB_*. En producción, un usuario con solo SELECT.
# ADMIN_NEW_DB_HOST=127.0.0.1
# ADMIN_NEW_DB_PORT=3306
# ADMIN_NEW_DB_USER=workflow_reader
# ADMIN_NEW_DB_PASSWORD=cambiar-por-una-clave-local

# Segundos entre ejecuciones del sincronizador (10 a 3600)
SYNC_INTERVAL_SECONDS=60

# Origen exacto del frontend. Las operaciones que cambian estado solo se aceptan desde aquí.
WEB_ORIGIN=http://localhost:4200

# Duración fija de una sesión, en horas (1 a 24)
SESSION_TTL_HOURS=8
