meta {
  name: 08 - Completar tarea manual
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/tareas/{{taskId}}/completar
  body: json
  auth: none
}

headers {
  x-usuario-id: {{managerId}}
  Content-Type: application/json
}

body:json {
  {
    "resultado": {}
  }
}

docs {
  Request genérico para una tarea manual. Cambia `taskId` y el header
  `x-usuario-id` al responsable real: adminId, managerId, bidderId o legalId.
}
